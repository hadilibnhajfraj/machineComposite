<svg xmlns="http://www.w3.org/2000/svg" width="800" height="500" viewBox="0 0 800 500">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0A2840"/>
      <stop offset="100%" stop-color="#0288D122"/>
    </linearGradient>
    <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#0288D1" stroke-width="0.4" opacity="0.3"/>
    </pattern>
  </defs>
  <rect width="800" height="500" fill="url(#bg)"/>
  <rect width="800" height="500" fill="url(#grid)"/>
  <text x="400" y="234" font-size="64" text-anchor="middle" dominant-baseline="middle">🌉</text>
  <text x="400" y="302" font-family="Arial,sans-serif" font-size="18" font-weight="600" fill="#0288D1" text-anchor="middle" opacity="0.9">Infrastructure</text>
</svg>